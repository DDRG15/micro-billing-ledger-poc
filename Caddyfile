# Caddyfile — Micro-Billing-Ledger reverse proxy + TLS
# ======================================================
# Caddy automatically obtains and renews a TLS certificate from
#     Let's Encrypt when CADDY_DOMAIN is set to a real domain and
#     port 443 is reachable from the internet.
#
#     To activate HTTPS in production:
#       1. Point your domain DNS to this server's IP.
#       2. Open port 443 on your firewall / security group.
#       3. Set CADDY_DOMAIN=billing.yourcompany.com in your .env file.
#       4. Run: docker-compose up -d
#       Caddy does the rest — no certbot, no cron, no manual renewal.
#
# LOCAL DEV:
#   With CADDY_DOMAIN=localhost (default in .env.example), Caddy uses
#   a self-signed certificate. Your browser will show a security warning —
#   this is expected for localhost. For local dev you can also access
#   the API directly on http://localhost:8000 (billing port is still exposed).

# Global server timeouts.
#     Scenario: Caddy's defaults leave header and body reads unbounded, so a client that
#     opens a connection and sends one byte every few seconds (slowloris) holds a
#     connection and its goroutine indefinitely; enough of them exhaust file descriptors
#     and the 100/minute rate limiter never sees a completed request to count.
#     Consequence: the ingress stops answering Stripe. Decision: cut a client that has
#     not finished its headers in 10 s or its body in 30 s (the body cap is 1 MiB), and
#     drop idle keep-alive connections after 2 minutes. Stripe's deliveries are small and
#     fast; 30 s for the body is generous for them.
{
    servers {
        timeouts {
            read_header 10s
            read_body   30s
            idle        2m
        }
    }

    # The default logger, which also writes the access line of a request whose Host matches
    #     no site (Caddy answers those 200 with an empty body). It gets the same header
    #     filter as the site's log below: measured, a wrong-Host request carrying X-Api-Key
    #     wrote the key to stdout through this logger.
    log {
        format filter {
            wrap json
            request>headers delete
        }
    }
}

{$CADDY_DOMAIN} {
    # Forward all traffic to the billing FastAPI container.
    #     The billing service is NOT exposed to the internet directly —
    #     all external traffic must pass through Caddy.
    # Refuse oversized bodies at the edge (413) before they reach the 256 MB billing
    #     container. The app enforces the same cap (MAX_REQUEST_BODY_BYTES) for traffic
    #     that does not pass through Caddy.
    request_body {
        max_size 1MiB
    }
    reverse_proxy billing:8000

    # Access log: one JSON line per request Caddy answers, to stdout (docker compose logs caddy).
    #     Scenario: until now Caddy wrote no access log. A 413 at the edge, a 502 while the
    #     billing container restarted, a client cut off mid-upload: none left a line, so the
    #     only account of a failed delivery was whatever the application saw, and the
    #     application never sees these.
    #     Consequence: Stripe reports failed deliveries and nothing on our side says why.
    #     Decision: log them. Caddy's default log writes every request header except
    #     Authorization and Cookie. X-Api-Key (the operator and tenant credential) and
    #     Stripe-Signature would land in plaintext, in a stream Docker keeps and log shippers
    #     copy. The filter deletes the whole request>headers object rather than naming
    #     secrets one by one, so a header added later cannot leak by omission.
    log {
        output stdout
        format filter {
            wrap json
            request>headers delete
        }
    }

    # Error class and type on the access line, with the same names the application uses
    #     (see "Error taxonomy" in ledger.py and the README). Only responses Caddy itself
    #     produces pass through handle_errors: 413 from request_body max_size, and 502 when
    #     billing:8000 cannot be reached. A 4xx or 5xx that the application returns is a
    #     normal proxied response; the application records its own class and type.
    #     Measured, not assumed: Caddy's 499 for a body that did not finish within read_body
    #     never reaches an error route, so it carries a status and no class or type; and a
    #     connection closed by read_header 10s produces no response and no log line at all.
    handle_errors 413 {
        log_append error_class size_limit
        log_append error_type body_too_large
    }

    handle_errors 502 {
        log_append error_class dependency
        log_append error_type upstream_unavailable
    }

    # Security headers — applied to every response.
    header {
        # Prevent clickjacking
        X-Frame-Options DENY
        # Prevent MIME type sniffing
        X-Content-Type-Options nosniff
        # Enable HSTS (tell browsers to always use HTTPS for this domain)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Remove server fingerprint
        -Server
    }
}
