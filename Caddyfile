# Caddyfile — Micro-Billing-Ledger reverse proxy + TLS
# ======================================================
# Caddy automatically obtains and renews a TLS certificate from
#     Let's Encrypt when CADDY_DOMAIN is set to a real domain and
#     port 443 is reachable from the internet.
#
#     To activate HTTPS in production:
#       1. Point your domain DNS to this server's IP.
#       2. Open port 443 on your firewall / security group.
#       3. Set CADDY_DOMAIN=billing.yourcompany.com in your .env file.
#       4. Run: docker-compose up -d
#       Caddy does the rest — no certbot, no cron, no manual renewal.
#
# LOCAL DEV:
#   With CADDY_DOMAIN=localhost (default in .env.example), Caddy uses
#   a self-signed certificate. Your browser will show a security warning —
#   this is expected for localhost. For local dev you can also access
#   the API directly on http://localhost:8000 (billing port is still exposed).

# Global server timeouts.
#     Scenario: Caddy's defaults leave header and body reads unbounded, so a client that
#     opens a connection and sends one byte every few seconds (slowloris) holds a
#     connection and its goroutine indefinitely; enough of them exhaust file descriptors
#     and the 100/minute rate limiter never sees a completed request to count.
#     Consequence: the ingress stops answering Stripe. Decision: cut a client that has
#     not finished its headers in 10 s or its body in 30 s (the body cap is 1 MiB), and
#     drop idle keep-alive connections after 2 minutes. Stripe's deliveries are small and
#     fast; 30 s for the body is generous for them.
{
    servers {
        timeouts {
            read_header 10s
            read_body   30s
            idle        2m
        }
    }
}

{$CADDY_DOMAIN} {
    # Forward all traffic to the billing FastAPI container.
    #     The billing service is NOT exposed to the internet directly —
    #     all external traffic must pass through Caddy.
    # Refuse oversized bodies at the edge (413) before they reach the 256 MB billing
    #     container. The app enforces the same cap (MAX_REQUEST_BODY_BYTES) for traffic
    #     that does not pass through Caddy.
    request_body {
        max_size 1MiB
    }
    reverse_proxy billing:8000

    # Security headers — applied to every response.
    header {
        # Prevent clickjacking
        X-Frame-Options DENY
        # Prevent MIME type sniffing
        X-Content-Type-Options nosniff
        # Enable HSTS (tell browsers to always use HTTPS for this domain)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Remove server fingerprint
        -Server
    }
}
