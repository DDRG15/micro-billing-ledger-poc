# .env.example — Micro-Billing-Ledger
# =====================================
# Copy this file to .env and fill in production values.
# The .env file is NEVER committed — it is in .gitignore.
#
# For local dev: the values below work as-is.
# For production: change ALL values marked with *** CHANGE ***.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# *** CHANGE IN PRODUCTION ***
# Use: openssl rand -hex 32

POSTGRES_DB=billing

# Full URL — must match POSTGRES_USER/PASSWORD/DB above.
# This is the OWNER connection and it goes to ONE service: migrate. Alembic issues DDL
# and creates the application role, so it needs rights the application must not hold.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/billing
# *** CHANGE IN PRODUCTION: postgresql://postgres:YOUR_PASSWORD@postgres:5432/billing ***

# The connection the SERVICE runs on — billing and worker, never migrate.
APP_DATABASE_URL=postgresql://billing_app:billing_app@postgres:5432/billing
# *** CHANGE IN PRODUCTION — the password below is published in this repository ***
#
# billing_app is created by migration 0006 as NOSUPERUSER NOBYPASSRLS with DML on the
# three tenant tables and SELECT on the org registry. Nothing else. That role is what
# makes row-level security apply at all: a SUPERUSER bypasses RLS entirely, ENABLE and
# FORCE included, so pointing this at `postgres` leaves the policies in place and inert.
#
# A migration cannot carry a secret, so 0006 creates the role with the literal password
# 'billing_app'. Replace it before this database is reachable from anywhere: RLS decides
# what a session may SEE, not who may open one. Put a real password in the URL above
# (openssl rand -hex 32) and run `docker compose up -d`: the migrate step (provision.py)
# sets billing_app's password to it — hashed client-side, so the clear value never
# reaches the server or its logs — before billing and worker connect with it.
# The service warns at startup for as long as this is the placeholder, and says which
# role it connected as either way:
#
#   docker compose logs billing | grep -E 'rls_enforced|rls_inert|placeholder'
#
# rls_inert means the policies exist and do not apply. It is not a warning about a
# future risk — it is the statement that tenant isolation is back to depending on every
# query remembering its own org_id predicate.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
# *** CHANGE ***
# Stripe Dashboard → Developers → Webhooks → Signing secret
# Format: whsec_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Billing API Key — protects the /dlq and /ledger/summary endpoints
# ---------------------------------------------------------------------------
BILLING_API_KEY=dev_key_change_in_production
# *** CHANGE IN PRODUCTION ***
# Use: openssl rand -hex 32
# Leave empty to disable auth (dev only).

# ---------------------------------------------------------------------------
# Dev mode — may this stack run on the demo values in this file?
# ---------------------------------------------------------------------------
BILLING_ENV=dev
# *** CHANGE IN PRODUCTION: delete this line ***
INGRESS_BIND_ADDR=127.0.0.1
# Where Caddy's ports 80/443 are published on the host. 0.0.0.0 to serve a real domain.
#
# The billing service refuses to start while it would serve traffic on a credential
# published in this repository — the placeholder signing secret (it VERIFIES: anyone can
# sign a webhook with it) in the env OR in any active org row, the default API key, a key
# under 32 characters, no API key at all, or the billing_app bootstrap password — unless
# BOTH hold:
#   BILLING_ENV=dev               the operator declared a development run
#   INGRESS_BIND_ADDR is loopback nothing beyond this machine can reach the ingress
# Unset BILLING_ENV means strict. Setting INGRESS_BIND_ADDR=0.0.0.0 revokes dev mode on
# its own, so exposing the stack and replacing the demo values cannot be done one
# without the other. The refusal names every offending setting, never its value:
#   docker compose logs billing | grep demo_credentials

# ---------------------------------------------------------------------------
# Worker — Outbox drain
# ---------------------------------------------------------------------------
DOWNSTREAM_URL=
# *** CHANGE IN PRODUCTION ***
# URL of the downstream system that receives events.
# Example: https://analytics.internal/billing-events
# Leave empty + WORKER_LOG_ONLY=true → log-only mode (no forwarding).

WORKER_LOG_ONLY=true
# *** CHANGE IN PRODUCTION: WORKER_LOG_ONLY=false ***
# Requires DOWNSTREAM_URL set. Without it the worker will not start.

WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL=5

# ---------------------------------------------------------------------------
# Caddy — automatic HTTPS / TLS
# ---------------------------------------------------------------------------
CADDY_DOMAIN=localhost
# *** CHANGE IN PRODUCTION ***
# Your real domain pointing to this server.
# Example: billing.yourcompany.com
#
# When you set a real domain and port 443 is open,
# Caddy obtains the Let's Encrypt certificate automatically.
# You do not need to do anything else to get HTTPS.

# ---------------------------------------------------------------------------
# Proxy trust — which peer may set X-Forwarded-For
# ---------------------------------------------------------------------------
FORWARDED_ALLOW_IPS=172.28.0.10
# Caddy's static address on the billing_net network (docker-compose.yml).
# The rate limiter keys on X-Forwarded-For, so any peer listed here can choose
# its own bucket. Keep this as narrow as possible and NEVER set it to "*".
#
# Must be a literal address: uvicorn 0.30.6 compares it as an exact string,
# not as a CIDR range. A subnet such as 172.28.0.0/16 matches nothing and
# silently turns X-Forwarded-For off, collapsing the limiter to one global bucket.
#
# Change this only if you change caddy's ipv4_address in docker-compose.yml.

# ---------------------------------------------------------------------------
# Secret rotation — read this before rotating anything
# ---------------------------------------------------------------------------
# Any secret below can instead be supplied as a file by setting <NAME>_FILE:
#     BILLING_API_KEY_FILE=/run/secrets/billing_api_key
#     STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
# That is the Docker/Kubernetes secrets convention, and it is the only way to rotate
# without replacing the container: a container's environment is immutable for its
# lifetime, but a mounted file can change underneath a running process.
# A configured but unreadable *_FILE makes the service refuse to start. It does not
# fall back to the env var — booting on the wrong credential silently is worse.
#
# TRAP: `docker compose restart` does NOT re-read this file. It restarts the existing
# container with its original environment, so a secret you just changed here will NOT
# be live. Use `docker compose up -d`, which recreates the container.
#
# To confirm which secret a running process actually has, without printing it:
#     docker compose logs billing | grep secrets_loaded
#     curl -H "X-Api-Key: $KEY" http://localhost:8000/metrics | grep billing_secrets_info
# Both show a SHA-256 prefix. Compare with:  sha256sum <<< "your-secret-value"
# The fingerprint is only safe to expose for a high-entropy secret. For a guessable
# one, a published hash is an offline dictionary attack waiting to happen.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_FORMAT=json
# json  — one JSON object per line. Use in containers and anywhere logs are shipped.
#         Fields like transaction_id, outcome and duration_ms become queryable
#         without parsing rules, and stay queryable when a log message is reworded.
# text  — human-readable single line. Use when tailing logs by eye locally.
#
# GET /metrics exposes Prometheus counters, a latency histogram, and the dlq_depth /
# outbox_pending gauges across every tenant. Operator only: it answers BILLING_API_KEY
# and refuses tenant keys with 403. Prometheus cannot send X-Api-Key through its
# `authorization:` block (that sends "Authorization: <type> <creds>"); use http_headers:
#   http_headers:
#     X-Api-Key:
#       files: [/etc/prom/billing.key]

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
DB_POOL_SIZE=20
# Applies to the BILLING service only. The worker pins its own to 1 in
# docker-compose.yml and deliberately does not read this value: worker.py imports
# ledger.py, so it inherits a pool it never uses, and at 20 that was 21 connections per
# worker replica instead of 2 — measured at 41 of 100 in use with a single replica of
# each service. Budget accordingly before scaling either one.
#
# minconn AND maxconn for the psycopg2 pool — they are deliberately the same value.
# psycopg2 returns a connection to the idle pool only while len(pool) < minconn and
# closes every other one on release, so minconn=1 makes the "pool" retain exactly one
# connection and reopen the rest per request. That measured 1 TPS at 4 concurrent
# clients with p50 latency of 4.2s. Size this to your PostgreSQL max_connections
# budget: every worker process holds DB_POOL_SIZE connections.

RATE_LIMIT_WEBHOOK=100/minute
RATE_LIMIT_OPS=20/minute
RATE_LIMIT_METRICS=60/minute
# Defaults match what was previously hardcoded. Raising RATE_LIMIT_WEBHOOK removes the
# protection against a flood exhausting the pool and growing outbox_pending without
# bound; it exists so `python benchmark.py` can measure the service instead of the
# limiter, and the app logs a warning whenever it is not the default.

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Every row carries org_id and the ledger primary key is (org_id, transaction_id),
# so the idempotency guard is per-tenant. Stripe event ids are unique per ACCOUNT,
# not globally — with a single-column key one tenant's event would silently discard
# another's as a duplicate.
#
# With no tenant registered, the service runs single-org: everything is 'default' and
# behaves exactly as it did before multi-tenancy was added. BILLING_API_KEY above maps to 'default'.
#
# To add a tenant, insert it and restart (the dev-vs-enforced-auth decision is read
# once at startup — the log line "tenancy mode=..." says which mode came up):
#
#   INSERT INTO org (org_id, name, api_key_sha256, stripe_webhook_secret)
#   VALUES ('acme', 'Acme Inc',
#           encode(digest('THEIR_API_KEY','sha256'),'hex'),   -- needs pgcrypto
#           'whsec_their_stripe_signing_secret');
#
# Or compute the hash outside the database:  printf '%s' "$KEY" | sha256sum
#
# The registry stores a SHA-256 of the API key, so a database dump does not hand over
# working credentials. The Stripe signing secret cannot be hashed — verifying an HMAC
# needs the value — so in production it belongs in a secret manager with this column
# holding a reference. Storing it here is a proof-of-concept shortcut.
#
# Once ANY tenant has a key, auth is enforced for every ops request and the caller's
# org is derived from their key. A caller cannot name its own tenant.
#
# Per-tenant ingest: point each Stripe account's webhook at its own path,
#   https://your-domain/webhook/stripe/acme
# The signature is verified with that tenant's stripe_webhook_secret, so the URL alone
# grants nothing — a caller without the secret cannot write into the tenant. An unknown
# org returns the same 400 as a bad signature, so the endpoint cannot be used to discover
# which tenants exist; check the logs for "webhook_unknown_org" when debugging.
#
# Per-tenant delivery (migration 0005): set org.downstream_url and that tenant's events
# are forwarded there instead of to DOWNSTREAM_URL above.
#   UPDATE org SET downstream_url = 'https://acme.example/billing-events' WHERE org_id='acme';
# NULL means "use DOWNSTREAM_URL", so a single-operator deployment needs no change.
# The worker drains round-robin across tenants: one tenant's backlog cannot starve another.
#
# NOTE on *_FILE under docker compose: the variables are forwarded to the container,
# but the FILE they point at must exist inside it. Add a bind mount or a Compose
# `secrets:` block yourself — this repo ships no mount, so setting *_FILE without one
# makes the service refuse to start (by design: it will not fall back to the env var).
